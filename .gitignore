# Godot's import cache and per-machine state.
.godot/
**/__pycache__/
.DS_Store
# The authored vehicle meshes are BUILD ARTIFACTS of model_sources/blender/*.py, exactly
# as they are for the web build (see the repo's .gitignore). tools/sync_assets.sh
# copies them in from web/assets after model_sources/blender/build.sh has produced them.
assets/craft/*.glb
assets/craft/*.glb.import
assets/pads/*.glb
assets/pads/*.glb.import
# Export output.
build/
