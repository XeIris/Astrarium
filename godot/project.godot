; Engine configuration file. See godot/PORT_GUIDE.md for why each of these is set.
config_version=5

[application]

config/name="Astrarium"
config/description="A relativistic orrery and a spaceflight simulator."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/resizable=true
window/dpi/allow_hidpi=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
driver/threads/thread_model=1
